GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional free fallbacks when Gemini is out of quota (OpenAI-compatible; tried in order: Groq, NVIDIA, OpenRouter)
# https://openrouter.ai/keys  (free models, e.g. Qwen, GLM, Gemma)
OPENROUTER_API_KEY=
# https://console.groq.com/keys  (free tier, very fast)
GROQ_API_KEY=
# https://build.nvidia.com  (free tier, ~40 RPM; nvapi-...)
NVIDIA_API_KEY=

# Podcast voices (main): Google Cloud TTS service account JSON, on ONE line (Cloud Text-to-Speech API enabled + billing)
GOOGLE_TTS_CREDENTIALS=
